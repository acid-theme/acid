# Generated. Renders the %%NAME%% preview: this port's own tool, a font, and
# whatever is needed to give it a display.
FROM docker.io/library/archlinux:latest

RUN pacman -Syu --noconfirm --needed --disable-download-timeout \
        %%PACKAGES%% \
        imagemagick \
        python \
        ttf-jetbrains-mono-nerd \
    && pacman -Scc --noconfirm

# Rootless podman refuses to exec a binary carrying an effective capability set,
# so they are stripped. sway and btop both ship with one.
RUN getcap -r /usr/bin /usr/sbin 2>/dev/null | cut -d' ' -f1 | xargs -r -n1 setcap -r || true

# Waybar will not start without a machine id. A no-op when dbus is not installed.
RUN command -v dbus-uuidgen >/dev/null && dbus-uuidgen --ensure=/etc/machine-id || true

ENV XDG_RUNTIME_DIR=/tmp/xdg
