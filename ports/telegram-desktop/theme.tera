// basic
windowBg: {{ flavor.colors.base }}; // white: fallback for background
windowFg: {{ flavor.colors.text }}; // black: fallback for text
windowBgOver: {{ flavor.colors.surface0 }}; // light gray: fallback for background with mouse over
windowBgRipple: {{ flavor.colors.surface1 }}; // darker gray: fallback for ripple effect
windowFgOver: windowFg; // black: fallback for text with mouse over
windowSubTextFg: {{ flavor.colors.subtext0 }}; // gray: fallback for additional text
windowSubTextFgOver: {{ flavor.colors.overlay2 }}; // darker gray: fallback for additional text with mouse over
windowBoldFg: {{ flavor.colors.text }}; // dark gray: fallback for bold text
windowBoldFgOver: {{ flavor.colors.text }}; // dark gray: fallback for bold text with mouse over
windowBgActive: {{ flavor.colors.blue }}; // bright blue: fallback for blue filled active areas
windowFgActive: {{ flavor.colors.base }}; // white: fallback for text on active areas
windowActiveTextFg: {{ flavor.colors.aqua }}; // online blue: fallback for active text like online status
windowShadowFg: {{ flavor.colors.crust }}; // black: fallback for shadow
windowShadowFgFallback: {{ flavor.colors.mantle }}; // gray: fallback for shadow without opacity

shadowFg: {{ flavor.colors.text | alpha(0.094) }}; // most shadows (including opacity)
slideFadeOutBg: {{ flavor.colors.base | alpha(0.235) }}; // slide animation (chat to profile) fade out filling
slideFadeOutShadowFg: windowShadowFg; // slide animation (chat to profile) fade out right section shadow

imageBg: {{ flavor.colors.base }}; // image background fallback (when photo size is less than minimum allowed)
imageBgTransparent: {{ flavor.colors.base }}; // image background when displaying an image with opacity where no opacity is needed

// widgets
activeButtonBg: windowBgActive; // default active button background
activeButtonBgOver: {{ flavor.colors.blue }}; // default active button background with mouse over
activeButtonBgRipple: {{ flavor.colors.blue }}; // default active button ripple effect
activeButtonFg: windowFgActive; // default active button text
activeButtonFgOver: activeButtonFg; // default active button text with mouse over
activeButtonSecondaryFg: {{ flavor.colors.text }}; // default active button additional text (selected messages counter in forward / delete buttons)
activeButtonSecondaryFgOver: activeButtonSecondaryFg; // default active button additional text with mouse over
activeLineFg: {{ flavor.colors.blue }}; // default active line (like code input field bottom border when you log in and field is focused)
activeLineFgError: {{ flavor.colors.red }}; // default active line for error state (like code input field bottom border when you log in and you've entered incorrect code)

lightButtonBg: windowBg; // default light button background (like buttons in boxes)
lightButtonBgOver: {{ flavor.colors.mantle }}; // default light button background with mouse over
lightButtonBgRipple: {{ flavor.colors.crust }}; // default light button ripple effect
lightButtonFg: windowActiveTextFg; // default light button text
lightButtonFgOver: lightButtonFg; // default light button text with mouse over

attentionButtonFg: {{ flavor.colors.red }}; // default attention button text (like confirm button on log out)
attentionButtonFgOver: {{ flavor.colors.red }}; // default attention button text with mouse over
attentionButtonBgOver: {{ flavor.colors.mantle }}; // default attention button background with mouse over
attentionButtonBgRipple: {{ flavor.colors.surface0 }}; // default attention button ripple effect

menuBg: {{ flavor.colors.surface0 }}; // default popup menu background
menuBgOver: windowBgOver; // default popup menu item background with mouse over
menuBgRipple: windowBgRipple; // default popup menu item ripple effect
menuIconFg: {{ flavor.colors.subtext0 }}; // default popup menu item icon (like main menu)
menuIconFgOver: {{ flavor.colors.overlay2 }}; // default popup menu item icon with mouse over
menuSubmenuArrowFg: {{ flavor.colors.subtext1 }}; // default popup menu submenu arrow icon (like in message field context menu in case of RTL system language)
menuFgDisabled: {{ flavor.colors.text }}; // default popup menu item disabled text (like unavailable items in message field context menu)
menuSeparatorFg: {{ flavor.colors.text }}; // default popup menu separator (like in message field context menu)

scrollBarBg: {{ flavor.colors.overlay0 | alpha(0.325) }}; // default scroll bar current rectangle, the bar itself (like in chats list)
scrollBarBgOver: {{ flavor.colors.base | alpha(0.478) }}; // default scroll bar current rectangle with mouse over it
scrollBg: {{ flavor.colors.surface0 | alpha(0.102) }}; // default scroll bar background
scrollBgOver: {{ flavor.colors.base | alpha(0.173) }}; // default scroll bar background with mouse over the scroll bar

smallCloseIconFg: {{ flavor.colors.subtext1 }}; // small X icon (like in Show all sessions box to the right for sessions termination)
smallCloseIconFgOver: {{ flavor.colors.subtext0 }}; // small X icon with mouse over

radialFg: windowFgActive; // default radial loader line (like in Media Viewer when loading a photo)
radialBg: {{ flavor.colors.base | alpha(0.337) }}; // default radial loader background (like in Media Viewer when loading a photo)

placeholderFg: windowSubTextFg; // default input field placeholder when field is not focused (like in phone input field when you log in)
placeholderFgActive: {{ flavor.colors.subtext1 }}; // default input field placeholder when field is focused
inputBorderFg: {{ flavor.colors.text }}; // default input field bottom border (like in code input field when you log in and field is not focused)
filterInputBorderFg: {{ flavor.colors.blue }}; // default rounded input field border (like in chats list search field when field is focused)
filterInputActiveBg: windowBg; // default rounded input field active background (like in chats list search field when field is focused)
filterInputInactiveBg: windowBgOver; // default rounded input field inactive background (like in chats list search field when field is inactive)
checkboxFg: {{ flavor.colors.subtext1 }}; // default unchecked checkbox rounded rectangle

botKbBg: menuBgOver; // bot keyboard button background
botKbDownBg: menuBgRipple; // bot keyboard button ripple effect
botKbColor: windowBoldFgOver; // bot keyboard button text
botKbPrimaryBg: {{ flavor.colors.blue | alpha(0.800) }}; // bot keyboard Primary button background
botKbDangerBg: {{ flavor.colors.red | alpha(0.800) }}; // bot keyboard Danger button background
botKbSuccessBg: {{ flavor.colors.green | alpha(0.800) }}; // bot keyboard Success button background
botKbInlinePrimaryBg: {{ flavor.colors.blue | alpha(0.702) }}; // inline bot keyboard Primary button background
botKbInlineDangerBg: {{ flavor.colors.red | alpha(0.702) }}; // inline bot keyboard Danger button background
botKbInlineSuccessBg: {{ flavor.colors.green | alpha(0.702) }}; // inline bot keyboard Success button background

sliderBgInactive: {{ flavor.colors.crust }}; // default slider not active bar (like in Settings when you choose interface scale or custom notifications count)
sliderBgActive: windowBgActive; // default slider active bar (like in Settings when you choose interface scale or custom notifications count)

tooltipBg: {{ flavor.colors.mantle }}; // tooltip background (like when you put mouse over the message timestamp and wait)
tooltipFg: {{ flavor.colors.overlay2 }}; // tooltip text
tooltipBorderFg: {{ flavor.colors.text }}; // tooltip border

// custom title bar
titleShadow: {{ flavor.colors.base | alpha(0.012) }}; // one pixel line shadow at the bottom of custom window title
titleBg: {{ flavor.colors.mantle }}; // custom window title background when window is inactive
titleBgActive: {{ flavor.colors.mantle }}; // custom window title background when window is active
titleButtonBg: titleBg; // custom window title minimize/maximize/restore button background when window is inactive (Windows only)
titleButtonFg: {{ flavor.colors.subtext1 }}; // custom window title minimize/maximize/restore button icon when window is inactive (Windows only)
titleButtonBgOver: {{ flavor.colors.crust }}; // custom window title minimize/maximize/restore button background with mouse over when window is inactive (Windows only)
titleButtonFgOver: {{ flavor.colors.subtext0 }}; // custom window title minimize/maximize/restore button icon with mouse over when window is inactive (Windows only)
titleButtonBgActive: titleButtonBg; // custom window title minimize/maximize/restore button background when window is active (Windows only)
titleButtonFgActive: titleButtonFg; // custom window title minimize/maximize/restore button icon when window is active (Windows only)
titleButtonBgActiveOver: titleButtonBgOver; // custom window title minimize/maximize/restore button background with mouse over when window is active (Windows only)
titleButtonFgActiveOver: titleButtonFgOver; // custom window title minimize/maximize/restore button icon with mouse over when window is active (Windows only)
titleButtonCloseBg: titleButtonBg; // custom window title close button background when window is inactive (Windows only)
titleButtonCloseFg: titleButtonFg; // custom window title close button icon when window is inactive (Windows only)
titleButtonCloseBgOver: {{ flavor.colors.red }}; // custom window title close button background with mouse over when window is inactive (Windows only)
titleButtonCloseFgOver: windowFgActive; // custom window title close button icon with mouse over when window is inactive (Windows only)
titleButtonCloseBgActive: titleButtonCloseBg; // custom window title close button background when window is active (Windows only)
titleButtonCloseFgActive: titleButtonCloseFg; // custom window title close button icon when window is active (Windows only)
titleButtonCloseBgActiveOver: titleButtonCloseBgOver; // custom window title close button background with mouse over when window is active (Windows only)
titleButtonCloseFgActiveOver: titleButtonCloseFgOver; // custom window title close button icon with mouse over when window is active (Windows only)
titleFg: {{ flavor.colors.subtext1 }}; // custom window title text when window is inactive (Windows 11 and macOS)
titleFgActive: {{ flavor.colors.subtext1 }}; // custom window title text when window is active (Windows 11 and macOS)

// tray icon
trayCounterBg: {{ flavor.colors.red }}; // tray icon counter background
trayCounterBgMute: {{ flavor.colors.overlay1 }}; // tray icon counter background if all unread messages are muted
trayCounterFg: {{ flavor.colors.base }}; // tray icon counter text
trayCounterBgMacInvert: {{ flavor.colors.base }}; // tray icon counter background when tray icon is pressed or when dark theme of macOS is used (macOS only)
trayCounterFgMacInvert: {{ flavor.colors.base | alpha(0.004) }}; // tray icon counter text when tray icon is pressed or when dark theme of macOS is used (macOS only)

// layers
layerBg: {{ flavor.colors.crust | alpha(0.498) }}; // box and main menu background layer fade

cancelIconFg: menuIconFg; // default for settings close icon and box search cancel icon
cancelIconFgOver: menuIconFgOver; // default for settings close icon and box search cancel icon with mouse over

// boxes
boxBg: {{ flavor.colors.base }}; // box background
boxTextFg: windowFg; // box text
boxTextFgGood: {{ flavor.colors.overlay2 }}; // accepted box text (like when choosing username that is not occupied)
boxTextFgError: {{ flavor.colors.red }}; // rejecting box text (like when choosing username that is occupied)
boxTitleFg: {{ flavor.colors.subtext1 }}; // box title text
boxSearchBg: boxBg; // box search field background (like in contacts box)

boxTitleAdditionalFg: {{ flavor.colors.overlay2 }}; // box title additional text (like in create group box when you see chosen members count)
boxTitleCloseFg: cancelIconFg; // settings close icon and box search cancel icon (like in contacts box)
boxTitleCloseFgOver: cancelIconFgOver; // settings close icon and box search cancel icon (like in contacts box) with mouse over

boxDividerBg: windowBgOver; // gray divider in boxes and layers
boxDividerFg: windowShadowFg; // gray divider shadow in boxes and layers

paymentsTipActive: {{ flavor.colors.subtext0 }}; // tip button text in payments checkout form

membersAboutLimitFg: windowSubTextFgOver; // text in channel members box about the limit (max 200 last members are shown)

contactsBg: windowBg; // contacts (and some other) box row background
contactsBgOver: windowBgOver; // contacts (and some other) box row background with mouse over
contactsNameFg: boxTextFg; // contacts (and some other) box row name text
contactsStatusFg: windowSubTextFg; // contacts (and some other) box row additional text (like last seen stamp)
contactsStatusFgOver: windowSubTextFgOver; // contacts (and some other) box row additional text (like last seen stamp) with mouse over
contactsStatusFgOnline: windowActiveTextFg; // contacts (and some other) box row active additional text (like online status)

photoCropFadeBg: layerBg; // avatar crop box fade background (when choosing a new photo in Settings or for a group)
photoCropPointFg: {{ flavor.colors.base | alpha(0.498) }}; // avatar crop box corner rectangles (when choosing a new photo in Settings or for a group)

callArrowFg: {{ flavor.colors.aqua }}; // received phone call arrow (in calls list box)
callArrowMissedFg: {{ flavor.colors.red }}; // missed phone call arrow (in calls list box)

// intro
introBg: windowBg; // login background
introTitleFg: windowBoldFg; // login title text
introDescriptionFg: windowSubTextFg; // login description text

introCoverTopBg: {{ flavor.colors.blue }}; // intro gradient top (from)
introCoverBottomBg: {{ flavor.colors.blue }}; // intro gradient bottom (to)
introCoverIconsFg: {{ flavor.colors.blue }}; // intro cloud graphics
introCoverPlaneTrace: {{ flavor.colors.blue | alpha(0.412) }}; // intro plane traces
introCoverPlaneInner: {{ flavor.colors.text }}; // intro plane part
introCoverPlaneOuter: {{ flavor.colors.subtext1 }}; // intro plane part
introCoverPlaneTop: {{ flavor.colors.base }}; // intro plane part

// dialogs
dialogsMenuIconFg: menuIconFg; // main menu and passcode lock icon
dialogsMenuIconFgOver: menuIconFgOver; // main menu and passcode lock icon with mouse over

dialogsBg: {{ flavor.colors.base }}; // chat list background
dialogsNameFg: windowBoldFg; // chat list name text
dialogsChatIconFg: dialogsNameFg; // chat list group or channel icon
dialogsDateFg: windowSubTextFg; // chat list date text
dialogsTextFg: windowSubTextFg; // chat list message text
dialogsTextFgService: windowActiveTextFg; // chat list group sender name text (or media message type text)
dialogsDraftFg: {{ flavor.colors.red }}; // chat list draft label
dialogsVerifiedIconBg: windowBgActive; // chat list verified icon background
dialogsVerifiedIconFg: windowFgActive; // chat list verified icon check
dialogsSendingIconFg: {{ flavor.colors.subtext1 }}; // chat list sending message icon (clock)
dialogsSentIconFg: {{ flavor.colors.green }}; // chat list sent message tick / double tick icon
dialogsUnreadBg: windowBgActive; // chat list unread badge background for not muted chat
dialogsUnreadBgMuted: {{ flavor.colors.surface2 }}; // chat list unread badge background for muted chat
dialogsUnreadFg: windowFgActive; // chat list unread badge text
dialogsArchiveFg: {{ flavor.colors.subtext1 }}; // chat list archive name text
dialogsOnlineBadgeFg: {{ flavor.colors.green }}; // chat list online status
dialogsScamFg: dialogsDraftFg; // chat list scam label

dialogsBgOver: {{ flavor.colors.surface0 }}; // chat list background with mouse over
dialogsNameFgOver: windowBoldFgOver; // chat list name text with mouse over
dialogsChatIconFgOver: dialogsNameFgOver; // chat list group or channel icon with mouse over
dialogsDateFgOver: windowSubTextFgOver; // chat list date text with mouse over
dialogsTextFgOver: windowSubTextFgOver; // chat list message text with mouse over
dialogsTextFgServiceOver: dialogsTextFgService; // chat list group sender name text with mouse over
dialogsDraftFgOver: dialogsDraftFg; // chat list draft label with mouse over
dialogsVerifiedIconBgOver: dialogsVerifiedIconBg; // chat list verified icon background with mouse over
dialogsVerifiedIconFgOver: dialogsVerifiedIconFg; // chat list verified icon check with mouse over
dialogsSendingIconFgOver: dialogsSendingIconFg; // chat list sending message icon (clock) with mouse over
dialogsSentIconFgOver: {{ flavor.colors.overlay2 }}; // chat list sent message tick / double tick icon with mouse over
dialogsUnreadBgOver: dialogsUnreadBg; // chat list unread badge background for not muted chat with mouse over
dialogsUnreadBgMutedOver: dialogsUnreadBgMuted; // chat list unread badge background for muted chat with mouse over
dialogsUnreadFgOver: dialogsUnreadFg; // chat list unread badge text with mouse over
dialogsArchiveFgOver: {{ flavor.colors.subtext1 }}; // chat list archive name text with mouse over
dialogsScamFgOver: dialogsDraftFgOver; // chat list scam label with mouse over

dialogsBgActive: {{ flavor.colors.surface2 }}; // chat list background for current (active) chat
dialogsNameFgActive: {{ flavor.colors.text }}; // chat list name text for current (active) chat
dialogsChatIconFgActive: dialogsNameFgActive; // chat list group or channel icon for current (active) chat
dialogsDateFgActive: windowFgActive; // chat list date text for current (active) chat
dialogsTextFgActive: windowFgActive; // chat list message text for current (active) chat
dialogsTextFgServiceActive: dialogsTextFgActive; // chat list group sender name text for current (active) chat
dialogsDraftFgActive: {{ flavor.colors.text }}; // chat list draft label for current (active) chat
dialogsVerifiedIconBgActive: dialogsTextFgActive; // chat list verified icon background for current (active) chat
dialogsVerifiedIconFgActive: dialogsBgActive; // chat list verified icon check for current (active) chat
dialogsSendingIconFgActive: {{ flavor.colors.base | alpha(0.600) }}; // chat list sending message icon (clock) for current (active) chat
dialogsSentIconFgActive: dialogsTextFgActive; // chat list sent message tick / double tick icon for current (active) chat
dialogsUnreadBgActive: dialogsTextFgActive; // chat list unread badge background for not muted chat for current (active) chat
dialogsUnreadBgMutedActive: dialogsDraftFgActive; // chat list unread badge background for muted chat for current (active) chat
dialogsUnreadFgActive: dialogsBgActive; // chat list unread badge text for current (active) chat
dialogsOnlineBadgeFgActive: {{ flavor.colors.base }}; // chat list online status for current (active) chat
dialogsScamFgActive: dialogsDraftFgActive; // chat list scam label for current (active) chat

dialogsRippleBg: windowBgRipple; // chat list background ripple effect
dialogsRippleBgActive: activeButtonBgRipple; // chat list background ripple effect for current (active) chat

searchedBarBg: windowBgOver; // search results bar background (in chats list, contacts box..)
searchedBarFg: windowSubTextFgOver; // search results bar text (in chats list, contacts box..)
searchedTextMatchBg: {{ flavor.colors.green }}; // in-page search results highlight background (Instant View, markdown editor)
searchedTextMatchFg: {{ flavor.colors.text }}; // in-page search results highlight text (Instant View, markdown editor)
searchedTextCurrentMatchBg: {{ flavor.colors.orange }}; // in-page search current result highlight background (Instant View, markdown editor)
searchedTextCurrentMatchFg: {{ flavor.colors.text }}; // in-page search current result highlight text (Instant View, markdown editor)

// history
topBarBg: windowBg; // top bar background (in chat view, media overview..)

emojiPanBg: windowBg; // emoji panel background
emojiPanCategories: {{ flavor.colors.text }}; // emoji panel categories background
emojiPanHeaderFg: windowSubTextFg; // emoji panel section header text
emojiPanHeaderBg: {{ flavor.colors.base | alpha(0.949) }}; // emoji panel section header background
emojiIconFg: {{ flavor.colors.subtext0 }}; // emoji category icon
emojiSubIconFgActive: {{ flavor.colors.subtext0 }}; // active emoji subcategory icon
stickerPanDeleteBg: {{ flavor.colors.base | alpha(1.000) }}; // delete X button background for custom sent stickers in stickers panel (legacy)
stickerPanDeleteFg: windowFgActive; // delete X button icon for custom sent stickers in stickers panel (legacy)
stickerPreviewBg: {{ flavor.colors.base | alpha(0.690) }}; // sticker and GIF preview background (when you press and hold on a sticker)
stickerPanPremium1: {{ flavor.colors.blue }}; // premium sticker pack icon gradient 1
stickerPanPremium2: {{ flavor.colors.blue }}; // premium sticker pack icon gradient 2

historyTextInFg: windowFg; // inbox message text
historyTextInFgSelected: historyTextInFg; // inbox message selected text or text in a selected message
historyTextOutFg: windowFg; // outbox message text
historyTextOutFgSelected: historyTextOutFg; // outbox message selected text or text in a selected message
historyLinkInFg: windowActiveTextFg; // inbox message link
historyLinkInFgSelected: historyLinkInFg; // inbox message link in a selected text or message
historyLinkOutFg: windowActiveTextFg; // outbox message link
historyLinkOutFgSelected: historyLinkOutFg; // outbox message link in a selected text or message
historyFileNameInFg: historyTextInFg; // inbox media filename text
historyFileNameInFgSelected: historyFileNameInFg; // inbox media filename text in a selected message
historyFileNameOutFg: historyTextOutFg; // outbox media filename text
historyFileNameOutFgSelected: historyFileNameOutFg; // outbox media filename text in a selected message
historyOutIconFg: {{ flavor.colors.overlay2 }}; // outbox message tick / double tick icon
historyOutIconFgSelected: {{ flavor.colors.overlay2 }}; // outbox message tick / double tick icon in a selected message
historyIconFgInverted: windowFgActive; // media message tick / double tick icon (like in sent photo)
historySendingOutIconFg: {{ flavor.colors.subtext1 }}; // outbox sending message icon (clock)
historySendingInIconFg: {{ flavor.colors.subtext1 }}; // inbox sending message icon (clock) (like in sent messages to yourself or in sent messages to a channel)
historySendingInvertedIconFg: {{ flavor.colors.base | alpha(0.784) }}; // media sending message icon (clock) (like in sent photo)
historyCallArrowInFg: {{ flavor.colors.aqua }}; // received phone call arrow
historyCallArrowInFgSelected: {{ flavor.colors.blue }}; // received phone call arrow in a selected message
historyCallArrowMissedInFg: callArrowMissedFg; // missed phone call arrow
historyCallArrowMissedInFgSelected: callArrowMissedFg; // missed phone call arrow in a selected message
historyCallArrowOutFg: historyCallArrowInFg; // outgoing phone call arrow
historyCallArrowOutFgSelected: historyCallArrowInFgSelected; // outgoing phone call arrow

historyUnreadBarBg: {{ flavor.colors.base }}; // new unread messages bar background
historyUnreadBarBorder: shadowFg; // new unread messages bar shadow
historyUnreadBarFg: {{ flavor.colors.overlay2 }}; // new unread messages bar text

historyForwardChooseBg: {{ flavor.colors.base | alpha(0.298) }}; // forwarding messages in a large window size "choose recipient" background
historyForwardChooseFg: windowFgActive; // forwarding messages in a large window size "choose recipient" text

historyPeer1NameFg: {{ flavor.colors.red }}; // red group member name
historyPeer1NameFgSelected: historyPeer1NameFg; // red group member name in a selected message
historyPeer1UserpicBg: {{ flavor.colors.red }}; // red userpic background
historyPeer2NameFg: {{ flavor.colors.green }}; // green group member name
historyPeer2NameFgSelected: historyPeer2NameFg; // green group member name in a selected message
