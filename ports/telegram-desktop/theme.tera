historyPeer3NameFg: {{ flavor.colors.yellow }}; // yellow group member name (actually unused)
historyPeer3NameFgSelected: historyPeer3NameFg; // yellow group member name in a selected message (actually unused)
historyPeer3UserpicBg: {{ flavor.colors.yellow }}; // yellow userpic background (actually unused)
historyPeer4NameFg: windowActiveTextFg; // blue group member name
historyPeer4NameFgSelected: historyPeer4NameFg; // blue group member name in a selected message
historyPeer4UserpicBg: {{ flavor.colors.blue }}; // blue userpic background
historyPeer5NameFg: {{ flavor.colors.purple }}; // purple group member name
historyPeer5NameFgSelected: historyPeer5NameFg; // purple group member name in a selected message
historyPeer5UserpicBg: {{ flavor.colors.aqua }}; // purple userpic background
historyPeer6NameFg: {{ flavor.colors.purple }}; // pink group member name
