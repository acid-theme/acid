historyPeer4UserpicBg2: {{ flavor.colors.blue | darken(0.12) }}; // the second blue userpic background
historyPeer5UserpicBg2: {{ flavor.colors.aqua | darken(0.12) }}; // the second purple userpic background
historyPeer6UserpicBg2: {{ flavor.colors.purple | darken(0.12) }}; // the second pink userpic background
historyPeer7UserpicBg2: {{ flavor.colors.orange | darken(0.12) }}; // the second sea userpic background
historyPeer8UserpicBg2: {{ flavor.colors.aqua | darken(0.12) }}; // the second orange userpic background
historyPeerSavedMessagesBg2: historyPeer4UserpicBg2; // the second saved messages userpic background

settingsIconBg1: {{ flavor.colors.red }}; // red settings icon background
settingsIconBg2: {{ flavor.colors.green }}; // green settings icon background
settingsIconBg3: {{ flavor.colors.yellow }}; // light-orange settings icon background
settingsIconBg4: {{ flavor.colors.blue }}; // light-blue settings icon background
settingsIconBg5: {{ flavor.colors.blue }}; // dark-blue settings icon background
settingsIconBg6: {{ flavor.colors.purple }}; // purple settings icon background
settingsIconBg8: {{ flavor.colors.orange }}; // dark-orange settings icon background
settingsIconBgArchive: {{ flavor.colors.overlay0 }}; // archive main menu icon background
settingsIconFg: {{ flavor.colors.base }}; // settings icon shape

// Some values are marked as (adjusted), it means they're adjusted by
// hue and saturation of the average background color if user chooses
// some other (not bundled to this color theme) background. If the
// bundled background is used those colors are not adjusted in any way.
historyScrollBarBg: {{ flavor.colors.overlay0 | alpha(0.478) }}; // scroll bar current rectangle, the bar itself in the chat view (adjusted)
