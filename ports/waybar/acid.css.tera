---
acidify:
  version: "0.1.0"
  matrix:
    - flavor
  filename: "themes/acid-{{ flavor.identifier }}.css"
---
/*
 * Acid {{ flavor.name }} for Waybar
 *
 * Generated by acidify from ports/waybar/acid.css.tera. Do not edit; edit the
 * template, or the palette in crates/acid-palette/src/lib.rs, and re-run
 * `make ports`.
 *
 * Import it at the top of your style.css and refer to the roles by name:
 *
 *     @import "themes/acid-{{ flavor.identifier }}.css";
 *
 *     window#waybar {
 *         background-color: @base;
 *         color: @text;
 *         border: 1px solid @surface1;
 *     }
 *
 * Keep the import above the rules, so a later definition can override it. GTK
 * reports no error for a colour name it does not know, so a missing role fails
 * silently rather than loudly.
 */

{% for color in flavor.color_list -%}
@define-color {{ color.identifier }} {{ color.hex }};
{% endfor %}
