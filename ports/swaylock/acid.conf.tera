---
acidify:
  version: "0.1.0"
  matrix:
    - flavor
  filename: "themes/acid-{{ flavor.identifier }}.conf"
---
{#-
  swaylock takes colours as bare `rrggbb[aa]` with no leading `#`, so every
  value here is piped through `bare`, or through `alpha` and then stripped.
  The repeated ones are hoisted so the body stays readable.
-#}
{%- set inside = flavor.colors.base | alpha(amount=0.6) | trim_start_matches(pat="#") -%}
{%- set line = flavor.colors.crust | bare -%}
{%- set layout_bg = flavor.colors.surface0 | alpha(amount=0.9) | trim_start_matches(pat="#") -%}
# Acid {{ flavor.name }} for swaylock
#
# Generated by acidify from ports/swaylock/acid.conf.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`.
#
# swaylock has no include directive, so this is a colours-only config to compose
# with, not to include. Either add local options to a copy and point swaylock
# at it with `swaylock -C`, or keep them in a separate file and concatenate:
#
#     cat base.conf themes/acid-{{ flavor.identifier }}.conf > ~/.config/swaylock/config
#
# An unrecognised key makes swaylock exit rather than lock, so keep the two
# files disjoint: options here, nothing else.

# Background, shown when no --image is given. An image overrides it.
color={{ flavor.colors.base | bare }}

# The indicator's inside, translucent so a wallpaper still reads through it.
inside-color={{ inside }}
inside-clear-color={{ inside }}
inside-caps-lock-color={{ inside }}
inside-ver-color={{ inside }}
inside-wrong-color={{ inside }}

# The hairline between inside and ring, and the gaps between key segments.
line-color={{ line }}
line-clear-color={{ line }}
line-caps-lock-color={{ line }}
line-ver-color={{ line }}
line-wrong-color={{ line }}
separator-color={{ line }}

# The ring carries the state: idle is a surface, then the accents escalate.
ring-color={{ flavor.colors.surface2 | bare }}
ring-clear-color={{ flavor.colors.green | bare }}
ring-caps-lock-color={{ flavor.colors.yellow | bare }}
ring-ver-color={{ flavor.colors.blue | bare }}
ring-wrong-color={{ flavor.colors.red | bare }}

# Keypress and backspace segments. Caps Lock recolours the keypress to yellow
# so the state is visible while typing; deletion stays orange either way.
key-hl-color={{ flavor.colors.aqua | bare }}
bs-hl-color={{ flavor.colors.orange | bare }}
caps-lock-key-hl-color={{ flavor.colors.yellow | bare }}
caps-lock-bs-hl-color={{ flavor.colors.orange | bare }}

# Indicator text, matching its ring.
text-color={{ flavor.colors.text | bare }}
text-clear-color={{ flavor.colors.green | bare }}
text-caps-lock-color={{ flavor.colors.yellow | bare }}
text-ver-color={{ flavor.colors.blue | bare }}
text-wrong-color={{ flavor.colors.red | bare }}

# The keyboard-layout box, shown with --show-keyboard-layout.
layout-bg-color={{ layout_bg }}
layout-border-color={{ flavor.colors.purple | bare }}
layout-text-color={{ flavor.colors.text | bare }}
