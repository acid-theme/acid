// Acid Acetic for niri
//
// Generated by acidify from ports/niri/acid.kdl.tera. Do not edit; edit the
// template, or the palette in crates/acid-palette/src/lib.rs, and re-run
// `make ports`.
//
// Pull it in from config.kdl. The path is relative to the including file, or
// absolute, or ~/-prefixed:
//
//     include "~/.config/niri/acid-acetic.kdl"
//
// niri merges an included `layout` block with the one in your config, which a
// second `layout` block in the same file cannot do. Keep the colour settings
// here and the geometry — gaps, widths, struts — in your own config, so the
// two never set the same key and precedence never has to be reasoned about.

layout {
    focus-ring {
        active-color "#ea7fc4"
        inactive-color "#383838"
        urgent-color "#ff4536"
    }

    border {
        active-color "#ea7fc4"
        inactive-color "#4a4a4a"
        urgent-color "#ff4536"
    }

    // Shadows read as depth against the workspace, not against a window, so
    // they are anchored to crust rather than to base.
    shadow {
        color "#141414b3"
        inactive-color "#14141473"
    }

    insert-hint {
        color "#ffc83273"
    }

    tab-indicator {
        active-color "#ea7fc4"
        inactive-color "#5a5a5a"
        urgent-color "#ff4536"
    }

    // The workspace background. Left commented because "transparent" is a
    // deliberate choice when a backdrop shows through; uncomment for an opaque
    // workspace.
    // background-color "#000000"
}

overview {
    backdrop-color "#141414"
}
