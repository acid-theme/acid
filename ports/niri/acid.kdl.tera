---
acidify:
  version: "0.1.0"
  matrix:
    - flavor
  filename: "themes/acid-{{ flavor.identifier }}.kdl"
---
// Acid {{ flavor.name }} for niri
//
// Generated by acidify from ports/niri/acid.kdl.tera. Do not edit; edit the
// template, or the palette in crates/acid-palette/src/lib.rs, and re-run
// `make ports`.
//
// Pull it in from config.kdl. The path is relative to the including file, or
// absolute, or ~/-prefixed:
//
//     include "~/.config/niri/acid-{{ flavor.identifier }}.kdl"
//
// niri merges an included `layout` block with the one in the main config, which
// a second `layout` block in the same file cannot do. Keep the colours here and
// the geometry — gaps, widths, struts — there, so the two never set the same key
// and precedence never has to be reasoned about.

layout {
    focus-ring {
        active-color "{{ flavor.colors.purple }}"
        inactive-color "{{ flavor.colors.surface1 }}"
        urgent-color "{{ flavor.colors.red }}"
    }

    border {
        active-color "{{ flavor.colors.purple }}"
        inactive-color "{{ flavor.colors.surface2 }}"
        urgent-color "{{ flavor.colors.red }}"
    }

    // Shadows read as depth against the workspace, not against a window, so
    // they are anchored to crust rather than to base.
    shadow {
        color "{{ flavor.colors.crust | alpha(amount=0.7) }}"
        inactive-color "{{ flavor.colors.crust | alpha(amount=0.45) }}"
    }

    insert-hint {
        color "{{ flavor.colors.yellow | alpha(amount=0.45) }}"
    }

    tab-indicator {
        active-color "{{ flavor.colors.purple }}"
        inactive-color "{{ flavor.colors.overlay0 }}"
        urgent-color "{{ flavor.colors.red }}"
    }

    // The workspace background. Left commented because "transparent" is a
    // deliberate choice when a backdrop shows through; uncomment for an opaque
    // workspace.
    // background-color "{{ flavor.colors.base }}"
}

overview {
    backdrop-color "{{ flavor.colors.crust }}"
}
