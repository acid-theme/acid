# Acid 0.1.0 — Citric, for btop
#
# Generated by acidify from ports/btop/acid.theme.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`.
#
# Copy to ~/.config/btop/themes/ and select it with `color_theme` in btop.conf.
# `theme_background = false` keeps the terminal's own background instead of
# main_bg.

# Main
theme[main_bg]="#1c1b19"
theme[main_fg]="#e2d6b6"
theme[title]="#e2d6b6"
theme[hi_fg]="#7cad76"
theme[selected_bg]="#5b554a"
theme[selected_fg]="#e2d6b6"
theme[inactive_fg]="#6b665c"
theme[graph_text]="#b4ab9b"
theme[meter_bg]="#49443b"
theme[proc_misc]="#9f988a"

# Boxes and dividers
theme[cpu_box]="#5b554a"
theme[mem_box]="#5b554a"
theme[net_box]="#5b554a"
theme[proc_box]="#5b554a"
theme[div_line]="#49443b"

# Load: cool to hot
theme[temp_start]="#a3ab2f"
theme[temp_mid]="#d9a441"
theme[temp_end]="#de5a48"
theme[cpu_start]="#a3ab2f"
theme[cpu_mid]="#d9a441"
theme[cpu_end]="#de5a48"
theme[process_start]="#a3ab2f"
theme[process_mid]="#d9a441"
theme[process_end]="#de5a48"

# Memory
theme[free_start]="#666a25"
theme[free_mid]="#a3ab2f"
theme[free_end]="#c2cb42"
theme[cached_start]="#516272"
theme[cached_mid]="#7d9cba"
theme[cached_end]="#9eb5cc"
theme[available_start]="#516b4c"
theme[available_mid]="#7cad76"
theme[available_end]="#9bc096"
theme[used_start]="#865028"
theme[used_mid]="#dd7b34"
theme[used_end]="#de5a48"

# Network
theme[download_start]="#516b4c"
theme[download_mid]="#7cad76"
theme[download_end]="#9bc096"
theme[upload_start]="#795461"
theme[upload_mid]="#c5839c"
theme[upload_end]="#d5a6b8"

# Following a process
theme[followed_bg]="#49443b"
theme[followed_fg]="#7cad76"
theme[proc_follow_bg]="#49443b"
theme[proc_banner_bg]="#35332c"
theme[proc_banner_fg]="#e2d6b6"
theme[proc_pause_bg]="#49443b"
