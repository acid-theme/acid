# Acid 0.1.0 — Acetic, for btop
#
# Generated by acidify from ports/btop/acid.theme.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`.
#
# Copy to ~/.config/btop/themes/ and select it with `color_theme` in btop.conf.
# `theme_background = false` keeps the terminal's own background instead of
# main_bg.

# Main
theme[main_bg]="#000000"
theme[main_fg]="#f2e9d0"
theme[title]="#f2e9d0"
theme[hi_fg]="#2fe0b8"
theme[selected_bg]="#4a4a4a"
theme[selected_fg]="#f2e9d0"
theme[inactive_fg]="#5a5a5a"
theme[graph_text]="#a49f95"
theme[meter_bg]="#383838"
theme[proc_misc]="#898989"

# Boxes and dividers
theme[cpu_box]="#4a4a4a"
theme[mem_box]="#4a4a4a"
theme[net_box]="#4a4a4a"
theme[proc_box]="#4a4a4a"
theme[div_line]="#383838"

# Load: cool to hot
theme[temp_start]="#c9e02b"
theme[temp_mid]="#ffc832"
theme[temp_end]="#ff4536"
theme[cpu_start]="#c9e02b"
theme[cpu_mid]="#ffc832"
theme[cpu_end]="#ff4536"
theme[process_start]="#c9e02b"
theme[process_mid]="#ffc832"
theme[process_end]="#ff4536"

# Memory
theme[free_start]="#6f7b18"
theme[free_mid]="#c9e02b"
theme[free_end]="#d4e757"
theme[cached_start]="#26648c"
theme[cached_mid]="#45b6ff"
theme[cached_end]="#78caff"
theme[available_start]="#1a7b65"
theme[available_mid]="#2fe0b8"
theme[available_end]="#5be7c7"
theme[used_start]="#8c4c11"
theme[used_mid]="#ff8b1f"
theme[used_end]="#ff4536"

# Network
theme[download_start]="#1a7b65"
theme[download_mid]="#2fe0b8"
theme[download_end]="#5be7c7"
theme[upload_start]="#81466c"
theme[upload_mid]="#ea7fc4"
theme[upload_end]="#f1abd8"

# Following a process
theme[followed_bg]="#383838"
theme[followed_fg]="#2fe0b8"
theme[proc_follow_bg]="#383838"
theme[proc_banner_bg]="#242424"
theme[proc_banner_fg]="#f2e9d0"
theme[proc_pause_bg]="#383838"
