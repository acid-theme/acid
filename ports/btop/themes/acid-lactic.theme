# Acid 0.1.0 — Lactic, for btop
#
# Generated by acidify from ports/btop/acid.theme.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`.
#
# Copy to ~/.config/btop/themes/ and select it with `color_theme` in btop.conf.
# `theme_background = false` keeps the terminal's own background instead of
# main_bg.

# Main
theme[main_bg]="#ffffff"
theme[main_fg]="#3a3117"
theme[title]="#3a3117"
theme[hi_fg]="#4a8143"
theme[selected_bg]="#b4ada2"
theme[selected_fg]="#3a3117"
theme[inactive_fg]="#9a958a"
theme[graph_text]="#5f5647"
theme[meter_bg]="#cbc6bf"
theme[proc_misc]="#706a5c"

# Boxes and dividers
theme[cpu_box]="#b4ada2"
theme[mem_box]="#b4ada2"
theme[net_box]="#b4ada2"
theme[proc_box]="#b4ada2"
theme[div_line]="#cbc6bf"

# Load: cool to hot
theme[temp_start]="#737914"
theme[temp_mid]="#9c6a0e"
theme[temp_end]="#df2910"
theme[cpu_start]="#737914"
theme[cpu_mid]="#9c6a0e"
theme[cpu_end]="#df2910"
theme[process_start]="#737914"
theme[process_mid]="#9c6a0e"
theme[process_end]="#df2910"

# Memory
theme[free_start]="#b2b57e"
theme[free_mid]="#737914"
theme[free_end]="#9da51b"
theme[cached_start]="#9bb5cd"
theme[cached_mid]="#4978a4"
theme[cached_end]="#6591bb"
theme[available_start]="#9bba98"
theme[available_mid]="#4a8143"
theme[available_end]="#5da354"
theme[used_start]="#dba279"
theme[used_mid]="#bd560b"
theme[used_end]="#df2910"

# Network
theme[download_start]="#9bba98"
theme[download_mid]="#4a8143"
theme[download_end]="#5da354"
theme[upload_start]="#da9db4"
theme[upload_mid]="#bc4d77"
theme[upload_end]="#ca7293"

# Following a process
theme[followed_bg]="#cbc6bf"
theme[followed_fg]="#4a8143"
theme[proc_follow_bg]="#cbc6bf"
theme[proc_banner_bg]="#e3e1dd"
theme[proc_banner_fg]="#3a3117"
theme[proc_pause_bg]="#cbc6bf"
