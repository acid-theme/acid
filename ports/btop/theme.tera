{#- Meters and graphs take a three-stop gradient. Single-hue ones ramp from a
    dimmed shade of the accent up to a brighter one; the load gradients run
    green to yellow to red, since they mean cool to hot. -#}
# Acid {{ version }} — {{ flavor.name }}, for btop
#
# Generated by acid from ports/btop/theme.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make`.
#
# Copy to ~/.config/btop/themes/ and select it with `color_theme` in btop.conf.
# `theme_background = false` keeps the terminal's own background instead of
# main_bg.

# Main
theme[main_bg]="{{ flavor.colors.base }}"
theme[main_fg]="{{ flavor.colors.text }}"
theme[title]="{{ flavor.colors.text }}"
theme[hi_fg]="{{ flavor.colors.aqua }}"
theme[selected_bg]="{{ flavor.colors.surface2 }}"
theme[selected_fg]="{{ flavor.colors.text }}"
theme[inactive_fg]="{{ flavor.colors.overlay0 }}"
theme[graph_text]="{{ flavor.colors.subtext0 }}"
theme[meter_bg]="{{ flavor.colors.surface1 }}"
theme[proc_misc]="{{ flavor.colors.overlay2 }}"

# Boxes and dividers
theme[cpu_box]="{{ flavor.colors.surface2 }}"
theme[mem_box]="{{ flavor.colors.surface2 }}"
theme[net_box]="{{ flavor.colors.surface2 }}"
theme[proc_box]="{{ flavor.colors.surface2 }}"
theme[div_line]="{{ flavor.colors.surface1 }}"

# Load: cool to hot
theme[temp_start]="{{ flavor.colors.green }}"
theme[temp_mid]="{{ flavor.colors.yellow }}"
theme[temp_end]="{{ flavor.colors.red }}"
theme[cpu_start]="{{ flavor.colors.green }}"
theme[cpu_mid]="{{ flavor.colors.yellow }}"
theme[cpu_end]="{{ flavor.colors.red }}"
theme[process_start]="{{ flavor.colors.green }}"
theme[process_mid]="{{ flavor.colors.yellow }}"
theme[process_end]="{{ flavor.colors.red }}"

# Memory
theme[free_start]="{{ flavor.colors.green | mix(flavor.colors.base, 0.45) }}"
theme[free_mid]="{{ flavor.colors.green }}"
theme[free_end]="{{ flavor.colors.green | lighten(0.10) }}"
theme[cached_start]="{{ flavor.colors.blue | mix(flavor.colors.base, 0.45) }}"
theme[cached_mid]="{{ flavor.colors.blue }}"
theme[cached_end]="{{ flavor.colors.blue | lighten(0.10) }}"
theme[available_start]="{{ flavor.colors.aqua | mix(flavor.colors.base, 0.45) }}"
theme[available_mid]="{{ flavor.colors.aqua }}"
theme[available_end]="{{ flavor.colors.aqua | lighten(0.10) }}"
theme[used_start]="{{ flavor.colors.orange | mix(flavor.colors.base, 0.45) }}"
theme[used_mid]="{{ flavor.colors.orange }}"
theme[used_end]="{{ flavor.colors.red }}"

# Network
theme[download_start]="{{ flavor.colors.aqua | mix(flavor.colors.base, 0.45) }}"
theme[download_mid]="{{ flavor.colors.aqua }}"
theme[download_end]="{{ flavor.colors.aqua | lighten(0.10) }}"
theme[upload_start]="{{ flavor.colors.purple | mix(flavor.colors.base, 0.45) }}"
theme[upload_mid]="{{ flavor.colors.purple }}"
theme[upload_end]="{{ flavor.colors.purple | lighten(0.10) }}"

# Following a process
theme[followed_bg]="{{ flavor.colors.surface1 }}"
theme[followed_fg]="{{ flavor.colors.aqua }}"
theme[proc_follow_bg]="{{ flavor.colors.surface1 }}"
theme[proc_banner_bg]="{{ flavor.colors.surface0 }}"
theme[proc_banner_fg]="{{ flavor.colors.text }}"
theme[proc_pause_bg]="{{ flavor.colors.surface1 }}"
