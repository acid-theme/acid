---
acidify:
  version: "0.1.0"
  matrix:
    - flavor
  filename: "themes/acid-{{ flavor.identifier }}.theme"
---
{#- Meters and graphs take a three-stop gradient. Single-hue ones ramp from a
    dimmed shade of the accent up to a brighter one; the load gradients run
    green to yellow to red, since they mean cool to hot. -#}
{%- macro ramp(colour) -%}
{{ colour | mix(with=flavor.colors.base, amount=0.45) }}|{{ colour }}|{{ colour | lighten(amount=0.10) }}
{%- endmacro ramp -%}
# Acid {{ version }} — {{ flavor.name }}, for btop
#
# Generated by acidify from ports/btop/acid.theme.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`.
#
# Copy to ~/.config/btop/themes/ and select it with `color_theme` in btop.conf.
# `theme_background = false` keeps the terminal's own background instead of
# main_bg.

# Main
theme[main_bg]="{{ flavor.colors.base }}"
theme[main_fg]="{{ flavor.colors.text }}"
theme[title]="{{ flavor.colors.text }}"
theme[hi_fg]="{{ flavor.colors.aqua }}"
theme[selected_bg]="{{ flavor.colors.surface2 }}"
theme[selected_fg]="{{ flavor.colors.text }}"
theme[inactive_fg]="{{ flavor.colors.overlay0 }}"
theme[graph_text]="{{ flavor.colors.subtext0 }}"
theme[meter_bg]="{{ flavor.colors.surface1 }}"
theme[proc_misc]="{{ flavor.colors.overlay2 }}"

# Boxes and dividers
theme[cpu_box]="{{ flavor.colors.surface2 }}"
theme[mem_box]="{{ flavor.colors.surface2 }}"
theme[net_box]="{{ flavor.colors.surface2 }}"
theme[proc_box]="{{ flavor.colors.surface2 }}"
theme[div_line]="{{ flavor.colors.surface1 }}"

# Load: cool to hot
{%- set load = [flavor.colors.green, flavor.colors.yellow, flavor.colors.red] %}
theme[temp_start]="{{ load[0] }}"
theme[temp_mid]="{{ load[1] }}"
theme[temp_end]="{{ load[2] }}"
theme[cpu_start]="{{ load[0] }}"
theme[cpu_mid]="{{ load[1] }}"
theme[cpu_end]="{{ load[2] }}"
theme[process_start]="{{ load[0] }}"
theme[process_mid]="{{ load[1] }}"
theme[process_end]="{{ load[2] }}"

# Memory
{%- set free = self::ramp(colour=flavor.colors.green) | split(pat="|") %}
{%- set cached = self::ramp(colour=flavor.colors.blue) | split(pat="|") %}
{%- set available = self::ramp(colour=flavor.colors.aqua) | split(pat="|") %}
theme[free_start]="{{ free[0] }}"
theme[free_mid]="{{ free[1] }}"
theme[free_end]="{{ free[2] }}"
theme[cached_start]="{{ cached[0] }}"
theme[cached_mid]="{{ cached[1] }}"
theme[cached_end]="{{ cached[2] }}"
theme[available_start]="{{ available[0] }}"
theme[available_mid]="{{ available[1] }}"
theme[available_end]="{{ available[2] }}"
theme[used_start]="{{ flavor.colors.orange | mix(with=flavor.colors.base, amount=0.45) }}"
theme[used_mid]="{{ flavor.colors.orange }}"
theme[used_end]="{{ flavor.colors.red }}"

# Network
{%- set download = self::ramp(colour=flavor.colors.aqua) | split(pat="|") %}
{%- set upload = self::ramp(colour=flavor.colors.purple) | split(pat="|") %}
theme[download_start]="{{ download[0] }}"
theme[download_mid]="{{ download[1] }}"
theme[download_end]="{{ download[2] }}"
theme[upload_start]="{{ upload[0] }}"
theme[upload_mid]="{{ upload[1] }}"
theme[upload_end]="{{ upload[2] }}"

# Following a process
theme[followed_bg]="{{ flavor.colors.surface1 }}"
theme[followed_fg]="{{ flavor.colors.aqua }}"
theme[proc_follow_bg]="{{ flavor.colors.surface1 }}"
theme[proc_banner_bg]="{{ flavor.colors.surface0 }}"
theme[proc_banner_fg]="{{ flavor.colors.text }}"
theme[proc_pause_bg]="{{ flavor.colors.surface1 }}"
