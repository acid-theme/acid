{#- Chrome sits on mantle, so the status line, menus and popups stand off the
    panes on both depth axes. The current window and the active pane border
    take the same accent, so the eye finds both together. Where tmux's own
    default switches colour on a state — a marked pane, a prompt in a pane — the
    condition is kept and only the colours change. -#}
# Acid {{ version }} — {{ flavor.name }}, for tmux
#
# Generated by acid from ports/tmux/theme.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make`.
#
# Colours only; the status line's content, key bindings and options stay in
# the main config. Source it from tmux.conf:
#
#     source-file ~/.config/tmux/acid-{{ flavor.identifier }}.conf
#
# Settings after the source-file line override the theme.
#
# Written for tmux 3.8. Every option is set with -q, so an older tmux skips the
# ones it does not have instead of reporting each, and draws the rest.

# Every role as a user option, so formats in the main config can name them:
#     set -g status-right "#[fg=#{@acid_aqua}]#S"
set -gq @acid_flavor "{{ flavor.identifier }}"
{%- for color in flavor.colors.iter() %}
set -gq @acid_{{ color.identifier }} "{{ color.hex }}"
{%- endfor %}

# tmux's own palette. Its built-in screens and every default style draw from
# it. Both sets get the flavour, so the terminal's light or dark report cannot
# swap it for another.
{%- for side in ["dark", "light"] %}
set -gq {{ side }}-theme-black "{{ flavor.colors.base }}"
set -gq {{ side }}-theme-red "{{ flavor.colors.red }}"
set -gq {{ side }}-theme-green "{{ flavor.colors.green }}"
set -gq {{ side }}-theme-yellow "{{ flavor.colors.yellow }}"
set -gq {{ side }}-theme-blue "{{ flavor.colors.blue }}"
set -gq {{ side }}-theme-magenta "{{ flavor.colors.purple }}"
set -gq {{ side }}-theme-cyan "{{ flavor.colors.aqua }}"
set -gq {{ side }}-theme-white "{{ flavor.colors.text }}"
set -gq {{ side }}-theme-light-grey "{{ flavor.colors.overlay2 }}"
set -gq {{ side }}-theme-dark-grey "{{ flavor.colors.surface0 }}"
{%- endfor %}

# Status line
set -gq status-style "fg={{ flavor.colors.subtext0 }},bg={{ flavor.colors.mantle }}"
set -gq status-left-style "fg={{ flavor.colors.text }},bg={{ flavor.colors.mantle }},bold"
set -gq status-right-style "fg={{ flavor.colors.subtext0 }},bg={{ flavor.colors.mantle }}"

# Windows in the status line
set -gq window-status-style "fg={{ flavor.colors.overlay2 }},bg={{ flavor.colors.mantle }}"
set -gq window-status-last-style "fg={{ flavor.colors.subtext1 }},bg={{ flavor.colors.mantle }}"
set -gq window-status-current-style "fg={{ flavor.colors.base }},bg={{ flavor.colors.blue }},bold"
set -gq window-status-activity-style "fg={{ flavor.colors.orange }},bg={{ flavor.colors.mantle }}"
set -gq window-status-bell-style "fg={{ flavor.colors.red }},bg={{ flavor.colors.mantle }},bold"

# Panes and sessions in a multi-line status line
set -gq pane-status-style "fg={{ flavor.colors.overlay2 }},bg={{ flavor.colors.mantle }}"
set -gq pane-status-current-style "fg={{ flavor.colors.base }},bg={{ flavor.colors.blue }},bold"
set -gq session-status-style "fg={{ flavor.colors.overlay2 }},bg={{ flavor.colors.mantle }}"
set -gq session-status-current-style "fg={{ flavor.colors.base }},bg={{ flavor.colors.blue }},bold"

# Pane borders. The active border says what the pane is doing: a popup over it,
# marked, synchronised, in a mode, or none of those.
set -gq pane-border-style "fg={{ flavor.colors.surface1 }}"
set -gq pane-active-border-style "fg=#{?pane_modal_flag,{{ flavor.colors.aqua }},#{?pane_marked,{{ flavor.colors.purple }},#{?synchronize-panes,{{ flavor.colors.red }},#{?pane_in_mode,{{ flavor.colors.yellow }},{{ flavor.colors.blue }}}}}}"
set -gq pane-scrollbars-style "fg={{ flavor.colors.surface2 }},bg={{ flavor.colors.mantle }},width=1,pad=0"
set -gq display-panes-colour "{{ flavor.colors.overlay1 }}"
set -gq display-panes-active-colour "{{ flavor.colors.blue }}"
set -gq display-panes-border-style "fg={{ flavor.colors.surface2 }},bg={{ flavor.colors.mantle }}"

# Messages and the command prompt. Both fill the status line, except when the
# prompt is drawn inside a pane or a mode.
set -gq message-style "fg={{ flavor.colors.text }},bg={{ flavor.colors.surface0 }},#{?#{m/r:(^|#,)IS(PANE|MODE)($|#,),#{prompt_flags}},,fill={{ flavor.colors.surface0 }}}"
set -gq message-command-style "fg={{ flavor.colors.yellow }},bg={{ flavor.colors.surface0 }},#{?#{m/r:(^|#,)IS(PANE|MODE)($|#,),#{prompt_flags}},,fill={{ flavor.colors.surface0 }}}"

# Copy mode. The selection and position indicator follow mode-style.
set -gq mode-style "fg={{ flavor.colors.text }},bg={{ flavor.colors.surface2 }}"
set -gq copy-mode-match-style "fg={{ flavor.colors.base }},bg={{ flavor.colors.overlay2 }}"
set -gq copy-mode-current-match-style "fg={{ flavor.colors.base }},bg={{ flavor.colors.yellow }}"
set -gq copy-mode-mark-style "fg={{ flavor.colors.base }},bg={{ flavor.colors.purple }}"
set -gq copy-mode-line-number-style "fg={{ flavor.colors.overlay1 }}"
set -gq copy-mode-current-line-number-style "fg={{ flavor.colors.yellow }}"
set -gq switch-mode-match-style "fg={{ flavor.colors.base }},bg={{ flavor.colors.aqua }}"

# Tree mode. The preview outlines the current pane or window in the accent of
# the active border.
set -gq tree-mode-border-style "fg={{ flavor.colors.surface2 }},bg={{ flavor.colors.mantle }}"
set -gq tree-mode-preview-style "fg=#{?#{||:#{&&:#{pane_format},#{pane_active}},#{&&:#{window_format},#{window_active}}},{{ flavor.colors.blue }},{{ flavor.colors.overlay1 }}}"

# Menus and popups
set -gq menu-style "fg={{ flavor.colors.text }},bg={{ flavor.colors.mantle }}"
set -gq menu-selected-style "fg={{ flavor.colors.text }},bg={{ flavor.colors.surface2 }}"
set -gq menu-border-style "fg={{ flavor.colors.surface2 }},bg={{ flavor.colors.mantle }}"
set -gq popup-style "fg={{ flavor.colors.text }},bg={{ flavor.colors.mantle }}"
set -gq popup-border-style "fg={{ flavor.colors.surface2 }},bg={{ flavor.colors.mantle }}"

# Clock mode
set -gq clock-mode-colour "{{ flavor.colors.blue }}"
