# Acid {{ version }} — {{ flavor.name }}, for aerc
#
# Generated by acid from ports/aerc/theme.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make`.
#
# Copy to ~/.config/aerc/stylesets/ and select it in aerc.conf:
#
#     [ui]
#     styleset-name=acid-{{ flavor.identifier }}

*.default=true
*.normal=true

# Selection raises the row rather than inverting it, so the colour that says
# unread or flagged survives being selected.
*.selected.bg={{ flavor.colors.surface2 }}
*.selected.bold=true

default.fg={{ flavor.colors.text }}
default.bg={{ flavor.colors.base }}

error.fg={{ flavor.colors.red }}
warning.fg={{ flavor.colors.orange }}
success.fg={{ flavor.colors.green }}

title.fg={{ flavor.colors.base }}
title.bg={{ flavor.colors.blue }}
title.bold=true
header.fg={{ flavor.colors.yellow }}
header.bold=true

# Message viewer header fields
realname.fg={{ flavor.colors.text }}
realname.bold=true
email.fg={{ flavor.colors.blue }}
subject.fg={{ flavor.colors.text }}
date.fg={{ flavor.colors.subtext0 }}

statusline_default.fg={{ flavor.colors.subtext1 }}
statusline_default.bg={{ flavor.colors.mantle }}
statusline_error.fg={{ flavor.colors.base }}
statusline_error.bg={{ flavor.colors.red }}
statusline_success.fg={{ flavor.colors.base }}
statusline_success.bg={{ flavor.colors.green }}

# Message list. The state of a message is its colour.
msglist_default.fg={{ flavor.colors.text }}
msglist_unread.fg={{ flavor.colors.blue }}
msglist_unread.bold=true
msglist_read.fg={{ flavor.colors.subtext0 }}
msglist_flagged.fg={{ flavor.colors.yellow }}
msglist_flagged.bold=true
msglist_deleted.fg={{ flavor.colors.overlay0 }}
msglist_marked.fg={{ flavor.colors.base }}
msglist_marked.bg={{ flavor.colors.aqua }}
msglist_result.fg={{ flavor.colors.base }}
msglist_result.bg={{ flavor.colors.yellow }}
msglist_answered.fg={{ flavor.colors.aqua }}
msglist_forwarded.fg={{ flavor.colors.purple }}
msglist_gutter.fg={{ flavor.colors.surface1 }}
msglist_pill.fg={{ flavor.colors.base }}
msglist_pill.bg={{ flavor.colors.purple }}
msglist_thread_context.fg={{ flavor.colors.overlay0 }}
msglist_thread_folded.fg={{ flavor.colors.aqua }}
msglist_thread_orphan.fg={{ flavor.colors.orange }}

dirlist_default.fg={{ flavor.colors.subtext1 }}
dirlist_unread.fg={{ flavor.colors.blue }}
dirlist_unread.bold=true
dirlist_recent.fg={{ flavor.colors.aqua }}

part_switcher.bg={{ flavor.colors.surface0 }}
part_filename.fg={{ flavor.colors.text }}
part_mimetype.fg={{ flavor.colors.overlay1 }}

completion_default.fg={{ flavor.colors.text }}
completion_default.bg={{ flavor.colors.surface0 }}
completion_description.fg={{ flavor.colors.overlay1 }}
completion_gutter.bg={{ flavor.colors.surface1 }}
completion_pill.fg={{ flavor.colors.base }}
completion_pill.bg={{ flavor.colors.aqua }}

keyhint_default.fg={{ flavor.colors.overlay1 }}
keyhint_key.fg={{ flavor.colors.yellow }}
keyhint_key.bold=true
keyhint_desc.fg={{ flavor.colors.subtext0 }}

selector_default.fg={{ flavor.colors.text }}
selector_chooser.fg={{ flavor.colors.aqua }}
selector_chooser.bold=true
selector_focused.fg={{ flavor.colors.base }}
selector_focused.bg={{ flavor.colors.aqua }}

tab.fg={{ flavor.colors.overlay1 }}
tab.bg={{ flavor.colors.mantle }}
tab.selected.fg={{ flavor.colors.text }}
tab.selected.bg={{ flavor.colors.surface0 }}
stack.bg={{ flavor.colors.base }}
spinner.fg={{ flavor.colors.aqua }}
border.fg={{ flavor.colors.surface2 }}
border.bg={{ flavor.colors.base }}

# aerc 0.22 documents style objects for quoted text, inline diffs, code, urls
# and signatures, and ships stylesets that use them, but its own parser rejects
# them — and one rejected object stops aerc starting. They are left out until
# the binary accepts them.
