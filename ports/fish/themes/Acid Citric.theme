# name: 'Acid Citric'
# url: 'https://github.com/ssiyad/acid'
# preferred_background: 1c1b19
#
# Generated by acidify from ports/fish/acid.fish.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`. Apply with: fish_config theme choose "Acid Citric"

# Syntax highlighting
fish_color_normal e2d6b6
fish_color_command 7cad76
fish_color_keyword c5839c
fish_color_quote a3ab2f
fish_color_redirection c5839c
fish_color_end c5839c
fish_color_error de5a48
fish_color_param e2d6b6
fish_color_option 7d9cba
fish_color_comment 857d70 --italics
fish_color_operator c5839c
fish_color_escape dd7b34
fish_color_autosuggestion 6b665c
fish_color_cancel de5a48
fish_color_gray 857d70
fish_color_selection e2d6b6 --background=5b554a
fish_color_search_match --background=5b554a
fish_color_match d9a441
fish_color_valid_path --underline
fish_color_history_current --bold

# Prompt
fish_color_cwd 7d9cba
fish_color_cwd_root de5a48
fish_color_user 7cad76
fish_color_host 7d9cba
fish_color_host_remote d9a441
fish_color_status de5a48

# Completion pager. The pager background is left unset so it inherits the
# terminal's own, which keeps a transparent terminal transparent.
fish_pager_color_prefix 7cad76 --bold
fish_pager_color_completion cabea7
fish_pager_color_description 857d70
fish_pager_color_progress b4ab9b --background=35332c
fish_pager_color_search_match --background=5b554a
fish_pager_color_selected_background --background=5b554a
fish_pager_color_selected_prefix 7cad76 --bold
fish_pager_color_selected_completion e2d6b6
fish_pager_color_selected_description b4ab9b
fish_pager_color_secondary_background --background=35332c
fish_pager_color_secondary_prefix 7cad76
fish_pager_color_secondary_completion cabea7
fish_pager_color_secondary_description 857d70
