# name: 'Acid Acetic'
# url: 'https://github.com/ssiyad/acid'
# preferred_background: 000000
#
# Generated by acidify from ports/fish/acid.fish.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`. Apply with: fish_config theme choose "Acid Acetic"

# Syntax highlighting
fish_color_normal f2e9d0
fish_color_command 2fe0b8
fish_color_keyword ea7fc4
fish_color_quote c9e02b
fish_color_redirection ea7fc4
fish_color_end ea7fc4
fish_color_error ff4536
fish_color_param f2e9d0
fish_color_option 45b6ff
fish_color_comment 6f6f6f --italics
fish_color_operator ea7fc4
fish_color_escape ff8b1f
fish_color_autosuggestion 555555
fish_color_cancel ff4536
fish_color_gray 6f6f6f
fish_color_selection f2e9d0 --background=3a3a3a
fish_color_search_match --background=3a3a3a
fish_color_match ffc832
fish_color_valid_path --underline
fish_color_history_current --bold

# Prompt
fish_color_cwd 45b6ff
fish_color_cwd_root ff4536
fish_color_user 2fe0b8
fish_color_host 45b6ff
fish_color_host_remote ffc832
fish_color_status ff4536

# Completion pager. The pager background is left unset so it inherits the
# terminal's own, which keeps a transparent terminal transparent.
fish_pager_color_prefix 2fe0b8 --bold
fish_pager_color_completion cdc7b8
fish_pager_color_description 6f6f6f
fish_pager_color_progress a8a49a --background=1e1e1e
fish_pager_color_search_match --background=3a3a3a
fish_pager_color_selected_background --background=3a3a3a
fish_pager_color_selected_prefix 2fe0b8 --bold
fish_pager_color_selected_completion f2e9d0
fish_pager_color_selected_description a8a49a
fish_pager_color_secondary_background --background=1e1e1e
fish_pager_color_secondary_prefix 2fe0b8
fish_pager_color_secondary_completion cdc7b8
fish_pager_color_secondary_description 6f6f6f
