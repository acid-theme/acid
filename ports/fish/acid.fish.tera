---
acidify:
  version: "0.1.0"
  matrix:
    - flavor
    - format: [theme, conf]
  filename: >-
    {% if format == "theme" %}themes/Acid {{ flavor.name }}.theme
    {%- else %}conf.d/acid-{{ flavor.identifier }}.fish{% endif %}
---
{#-
  Two formats from one mapping. `theme` is the distributable form that
  `fish_config theme choose` reads and writes to universal variables; `conf`
  sets the same variables globally, for configs kept under version control
  where universal variables are not committed.
-#}
{%- if format == "conf" %}{% set prefix = "set -g " %}{% else %}{% set prefix = "" %}{% endif -%}
{%- if format == "theme" -%}
# name: 'Acid {{ flavor.name }}'
# url: 'https://github.com/acid-theme/acid'
# preferred_background: {{ flavor.colors.base | bare }}
#
# Acid {{ version }}. Generated by acidify from ports/fish/acid.fish.tera. Do
# not edit; edit the template, or the palette in crates/acid-palette/src/lib.rs,
# and re-run `make ports`.
# Apply with: fish_config theme choose "Acid {{ flavor.name }}"
{%- else -%}
# Acid {{ version }} — {{ flavor.name }}, for fish
#
# Generated by acidify from ports/fish/acid.fish.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`.
#
# These are global rather than universal variables, so the theme lives in
# tracked config and survives on any machine. Drop this in ~/.config/fish/conf.d
# and it applies on the next shell.
{%- endif %}

# Syntax highlighting
{{ prefix }}fish_color_normal {{ flavor.colors.text | bare }}
{{ prefix }}fish_color_command {{ flavor.colors.aqua | bare }}
{{ prefix }}fish_color_keyword {{ flavor.colors.purple | bare }}
{{ prefix }}fish_color_quote {{ flavor.colors.green | bare }}
{{ prefix }}fish_color_redirection {{ flavor.colors.purple | bare }}
{{ prefix }}fish_color_end {{ flavor.colors.purple | bare }}
{{ prefix }}fish_color_error {{ flavor.colors.red | bare }}
{{ prefix }}fish_color_param {{ flavor.colors.text | bare }}
{{ prefix }}fish_color_option {{ flavor.colors.blue | bare }}
{{ prefix }}fish_color_comment {{ flavor.colors.overlay1 | bare }} --italics
{{ prefix }}fish_color_operator {{ flavor.colors.purple | bare }}
{{ prefix }}fish_color_escape {{ flavor.colors.orange | bare }}
{{ prefix }}fish_color_autosuggestion {{ flavor.colors.overlay0 | bare }}
{{ prefix }}fish_color_cancel {{ flavor.colors.red | bare }}
{{ prefix }}fish_color_gray {{ flavor.colors.overlay1 | bare }}
{{ prefix }}fish_color_selection {{ flavor.colors.text | bare }} --background={{ flavor.colors.surface2 | bare }}
{{ prefix }}fish_color_search_match --background={{ flavor.colors.surface2 | bare }}
{{ prefix }}fish_color_match {{ flavor.colors.yellow | bare }}
{{ prefix }}fish_color_valid_path --underline
{{ prefix }}fish_color_history_current --bold

# Prompt
{{ prefix }}fish_color_cwd {{ flavor.colors.blue | bare }}
{{ prefix }}fish_color_cwd_root {{ flavor.colors.red | bare }}
{{ prefix }}fish_color_user {{ flavor.colors.aqua | bare }}
{{ prefix }}fish_color_host {{ flavor.colors.blue | bare }}
{{ prefix }}fish_color_host_remote {{ flavor.colors.yellow | bare }}
{{ prefix }}fish_color_status {{ flavor.colors.red | bare }}

# Completion pager. The pager background is left unset so it inherits the
# terminal's own, which keeps a transparent terminal transparent.
{{ prefix }}fish_pager_color_prefix {{ flavor.colors.aqua | bare }} --bold
{{ prefix }}fish_pager_color_completion {{ flavor.colors.subtext1 | bare }}
{{ prefix }}fish_pager_color_description {{ flavor.colors.overlay1 | bare }}
{{ prefix }}fish_pager_color_progress {{ flavor.colors.subtext0 | bare }} --background={{ flavor.colors.surface0 | bare }}
{{ prefix }}fish_pager_color_search_match --background={{ flavor.colors.surface2 | bare }}
{{ prefix }}fish_pager_color_selected_background --background={{ flavor.colors.surface2 | bare }}
{{ prefix }}fish_pager_color_selected_prefix {{ flavor.colors.aqua | bare }} --bold
{{ prefix }}fish_pager_color_selected_completion {{ flavor.colors.text | bare }}
{{ prefix }}fish_pager_color_selected_description {{ flavor.colors.subtext0 | bare }}
{{ prefix }}fish_pager_color_secondary_background --background={{ flavor.colors.surface0 | bare }}
{{ prefix }}fish_pager_color_secondary_prefix {{ flavor.colors.aqua | bare }}
{{ prefix }}fish_pager_color_secondary_completion {{ flavor.colors.subtext1 | bare }}
{{ prefix }}fish_pager_color_secondary_description {{ flavor.colors.overlay1 | bare }}
