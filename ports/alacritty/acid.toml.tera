---
acidify:
  version: "0.1.0"
  matrix:
    - flavor
  filename: "themes/acid-{{ flavor.identifier }}.toml"
---
# Acid {{ version }} — {{ flavor.name }}, for Alacritty
#
# Generated by acidify from ports/alacritty/acid.toml.tera. Do not edit; edit
# the template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`.
#
# Import it from alacritty.toml:
#   [general]
#   import = ["~/.config/alacritty/themes/acid-{{ flavor.identifier }}.toml"]

[colors.primary]
background = "{{ flavor.colors.base }}"
foreground = "{{ flavor.colors.text }}"
dim_foreground = "{{ flavor.colors.subtext0 }}"
bright_foreground = "{{ flavor.colors.text | lighten(amount=0.04) }}"

[colors.cursor]
text = "{{ flavor.colors.base }}"
cursor = "{{ flavor.colors.yellow }}"

[colors.vi_mode_cursor]
text = "{{ flavor.colors.base }}"
cursor = "{{ flavor.colors.aqua }}"

[colors.search.matches]
foreground = "{{ flavor.colors.base }}"
background = "{{ flavor.colors.overlay2 }}"

[colors.search.focused_match]
foreground = "{{ flavor.colors.base }}"
background = "{{ flavor.colors.yellow }}"

[colors.hints.start]
foreground = "{{ flavor.colors.base }}"
background = "{{ flavor.colors.yellow }}"

[colors.hints.end]
foreground = "{{ flavor.colors.base }}"
background = "{{ flavor.colors.overlay2 }}"

# Chrome sits behind the editor field, so it follows the flavour's depth axis:
# mantle is lighter than base in acetic, darker in citric.
[colors.footer_bar]
foreground = "{{ flavor.colors.subtext1 }}"
background = "{{ flavor.colors.mantle }}"

[colors.line_indicator]
foreground = "{{ flavor.colors.subtext1 }}"
background = "{{ flavor.colors.mantle }}"

[colors.selection]
text = "{{ flavor.colors.text }}"
background = "{{ flavor.colors.surface2 }}"

# ANSI 0-7. `black` is a visible surface rather than the background, so that
# black-on-black text stays legible.
[colors.normal]
black = "{{ flavor.colors.surface1 }}"
red = "{{ flavor.colors.red }}"
green = "{{ flavor.colors.green }}"
yellow = "{{ flavor.colors.yellow }}"
blue = "{{ flavor.colors.blue }}"
magenta = "{{ flavor.colors.purple }}"
cyan = "{{ flavor.colors.aqua }}"
white = "{{ flavor.colors.subtext1 }}"

# ANSI 8-15.
[colors.bright]
black = "{{ flavor.colors.surface2 }}"
red = "{{ flavor.colors.red | lighten(amount=0.08) }}"
green = "{{ flavor.colors.green | lighten(amount=0.08) }}"
yellow = "{{ flavor.colors.yellow | lighten(amount=0.08) }}"
blue = "{{ flavor.colors.blue | lighten(amount=0.08) }}"
magenta = "{{ flavor.colors.purple | lighten(amount=0.08) }}"
cyan = "{{ flavor.colors.aqua | lighten(amount=0.08) }}"
white = "{{ flavor.colors.text }}"

# Dim colours are blended towards the background rather than darkened, so they
# recede without shifting hue.
[colors.dim]
black = "{{ flavor.colors.surface0 }}"
red = "{{ flavor.colors.red | mix(with=flavor.colors.base, amount=0.3) }}"
green = "{{ flavor.colors.green | mix(with=flavor.colors.base, amount=0.3) }}"
yellow = "{{ flavor.colors.yellow | mix(with=flavor.colors.base, amount=0.3) }}"
blue = "{{ flavor.colors.blue | mix(with=flavor.colors.base, amount=0.3) }}"
magenta = "{{ flavor.colors.purple | mix(with=flavor.colors.base, amount=0.3) }}"
cyan = "{{ flavor.colors.aqua | mix(with=flavor.colors.base, amount=0.3) }}"
white = "{{ flavor.colors.subtext0 }}"

# Orange has no ANSI slot. Index 16 is where gruvbox puts it, so tools that
# already know that convention pick it up.
[[colors.indexed_colors]]
index = 16
color = "{{ flavor.colors.orange }}"
