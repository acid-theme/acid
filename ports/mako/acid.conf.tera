---
acidify:
  version: "0.1.0"
  matrix:
    - flavor
  filename: "themes/acid-{{ flavor.identifier }}.conf"
---
# Acid {{ version }} — {{ flavor.name }}, for mako
#
# Generated by acidify from ports/mako/acid.conf.tera. Do not edit; edit the
# template, or the palette in crates/acid-palette/src/lib.rs, and re-run
# `make ports`.
#
# Colours only; timeouts, geometry and fonts stay in the main config. Pull it
# in with an absolute or ~/-prefixed path:
#
#     include=~/.config/mako/acid-{{ flavor.identifier }}.conf
#
# mako applies the last matching value, so settings after the include override
# the theme and settings before it are overridden. The criteria sections below
# are self-contained and do not leak into the including file.

background-color={{ flavor.colors.base }}
text-color={{ flavor.colors.text }}
border-color={{ flavor.colors.blue }}
progress-color=over {{ flavor.colors.surface0 }}

[urgency=low]
text-color={{ flavor.colors.subtext1 }}
border-color={{ flavor.colors.overlay0 }}

[urgency=normal]
text-color={{ flavor.colors.text }}
border-color={{ flavor.colors.blue }}

[urgency=high]
text-color={{ flavor.colors.text }}
border-color={{ flavor.colors.red }}

# The "N more" placeholder recedes; it is chrome, not a notification.
[hidden]
text-color={{ flavor.colors.overlay1 }}
border-color={{ flavor.colors.surface2 }}
