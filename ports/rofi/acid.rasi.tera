---
acidify:
  version: "0.1.0"
  matrix:
    - flavor
  filename: "themes/acid-{{ flavor.identifier }}.rasi"
---
/*
 * Acid {{ version }} — {{ flavor.name }}, for rofi
 *
 * Generated by acidify from ports/rofi/acid.rasi.tera. Do not edit; edit the
 * template, or the palette in crates/acid-palette/src/lib.rs, and re-run
 * `make ports`.
 *
 * The role names only. Import it and map them onto rofi's widgets:
 *
 *     @import "acid-{{ flavor.identifier }}"
 *
 *     * {
 *         background-color: @base;
 *         text-color:       @text;
 *     }
 */

* {
{% for color in flavor.color_list %}    {{ color.identifier }}: {{ color.hex }};
{% endfor %}}
